{
  "name": "yhsi-api",
  "version": "1.0.0",
  "description": "API for YHSI Application",
  "main": "server.js",
  "scripts": {
    "start": "ts-node-dev -r tsconfig-paths/register index.ts",
    "initializers": "ts-node -r tsconfig-paths/register --files initializers/index.ts",
    "development": "pm2 start ecosystem.config.js --no-daemon",
    "start-yhsif": "nodemon index.ts",
    "build": "tsc && tsc-alias",
    "lint": "eslint . --ext .js,.ts --ignore-path ../.gitignore",
    "knex": "ts-node -r tsconfig-paths/register ./node_modules/.bin/knex --knexfile ./config.d/knexfile.ts"
  },
  "author": "Michael Johnson",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^7.53.1",
    "@types/axios": "^0.14.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^8.6.0",
    "express": "^4.17.1",
    "express-handlebars": "^7.1.2",
    "express-openid-connect": "^2.7.2",
    "express-session": "^1.17.1",
    "express-validator": "^6.12.1",
    "helmet": "^5.0.2",
    "json2csv": "^5.0.7",
    "knex": "^3.3.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "multer": "^1.4.3",
    "pug": "^3.0.2",
    "puppeteer": "^25.19.0",
    "sharp": "^0.35.5",
    "tedious": "^18.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.13",
    "@types/express-session": "^1.17.0",
    "@types/lodash": "^4.14.172",
    "@types/multer": "^1.4.7",
    "@types/node": "^24.19.4",
    "@types/pug": "^2.0.6",
    "@typescript-eslint/eslint-plugin": "^5.20.0",
    "@typescript-eslint/parser": "^5.20.0",
    "eslint": "^8.13.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "nodemon": "^2.0.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
